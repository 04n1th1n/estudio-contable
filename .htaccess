# JVL Auditores Consultores - Optimización de servidor

# ====================================
# Activar módulos necesarios
# ====================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
</IfModule>

# ====================================
# Compresión GZIP
# ====================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
</IfModule>

# ====================================
# Caché del navegador (Browser Caching)
# ====================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Imágenes
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/x-win-bitmap "access plus 1 year"

  # CSS y JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # Fuentes (CDN externo, no aplica aquí pero sí para assets locales)
  ExpiresByType font/ttf "access plus 2 years"
  ExpiresByType font/otf "access plus 2 years"
  ExpiresByType font/woff "access plus 2 years"
  ExpiresByType font/woff2 "access plus 2 years"
  ExpiresByType application/font-woff "access plus 2 years"

  # Documentos
  ExpiresByType text/html "access plus 2 weeks"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/xml "access plus 2 weeks"
  ExpiresByType application/xml "access plus 2 weeks"
</IfModule>

# ====================================
# Headers de seguridad y SEO
# ====================================
<IfModule mod_headers.c>
  # Prevenir clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # XSS Protection
  Header always set X-XSS-Protection "1; mode=block"

  # MIME Type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Canonical header
  Header always set Link "</index.html>; rel=\"canonical\""
</IfModule>

# ====================================
# Redirecciones y URLs limpias
# ====================================
<IfModule mod_rewrite.c>
  # Remover www
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [R=301,L]

  # HTTPS forzado
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Archivos estáticos
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]

  # Sitemap y robots
  RewriteRule ^sitemap\.xml$ sitemap.xml [L]
  RewriteRule ^robots\.txt$ robots.txt [L]
</IfModule>

# ====================================
# Bloquear acceso a archivos sensibles
# ====================================
<FilesMatch "^(\.env|\.git|composer\.json|composer\.lock)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# ====================================
# Tipos MIME
# ====================================
AddType application/json json
AddType application/ld+json jsonld
AddType application/manifest+json webmanifest
AddType application/xml+rss rss
AddType image/svg+xml svg svgz
AddEncoding gzip svgz
